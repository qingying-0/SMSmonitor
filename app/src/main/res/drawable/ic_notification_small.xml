<?xml version="1.0" encoding="utf-8"?>
<!--
  通知栏小图标：对话气泡 + 铃铛（消息闹钟）。

  为什么通知小图标不等于应用图标：
    1. 系统只保留 Alpha 通道并强制单色，照片会变成无法辨认的色块；
    2. 24dp 是通知图标的实际显示尺寸（作者画布 24dp，系统不再放大），
       在这个尺寸下照片剪影实测完全糊成一团。
  所以状态栏用这个可辨识的符号；通知正文里的彩色原图由 setLargeIcon
  提供（见 drawable-*/ic_notification_large.webp）。

  注意：多个 <path> 是叠加遮挡而非布尔合并，因此铃铛必须作为"洞"
  直接挖在气泡轮廓里（单条 path + fillType="evenOdd"）。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
